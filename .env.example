# The app runs on Neon (data) + Firebase (auth) — no client-side keys needed
# here. Backend secrets (NEON_DATABASE_URL, FIREBASE_SA_KEY, RESEND_API_KEY,
# CF_ANALYTICS_TOKEN) live in the Cloudflare Pages project settings.

# Root domain client sites are served under (<subdomain>.<this>). Optional —
# falls back to the value in src/config/site.js if unset. See that file for the
# full "how to change your platform domain" steps.
VITE_PLATFORM_DOMAIN=celebrately.us

# Brand name shown in the superadmin. Optional — falls back to src/config/site.js.
VITE_BRAND_NAME=Evermore
